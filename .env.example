VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Neon (PostgreSQL) pour le stockage des dossiers de prêt
DATABASE_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Mot de passe de l'espace admin (défaut : 2026#*)
ADMIN_PASSWORD=2026#*

# SMTP pour envoi d'emails (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=votre.email@gmail.com
SMTP_PASS=votre-app-password
FROM_EMAIL=votre.email@gmail.com
FROM_NAME=Prêt Rapide Canada
ADMIN_EMAIL=admin@exemple.com
